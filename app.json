{
  "expo": {
    "name": "Tapis Decoland AR",
    "slug": "tapisdecoland-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.tapisdecoland.ar",
      "buildNumber": "10",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application utilise la caméra pour la réalité augmentée afin de visualiser les tapis dans votre intérieur."
      }
    },
    "android": {
      "package": "be.tapisdecoland.ar"
    },
    "plugins": [
      "expo-router",
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": ["AR"]
          }
        }
      ]
    ],
    "scheme": "tapisdecoland"
  }
}
